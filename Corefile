# =============================================================================
# SUB-DOMAINS - Redirect to single IP
# =============================================================================
pages.semantec.lan {
    template ANY A {
        answer "{{ .Name }} 60 IN A 192.168.0.22"
    }
}

# =============================================================================
# EXTERNAL DOMAINS - Forward to Public DNS
# =============================================================================
. {
    forward . 8.8.8.8 1.1.1.1
    cache 30
    log
    errors

    # Expose metrics on port 9153 for all zones
    prometheus 0.0.0.0:9153
}
