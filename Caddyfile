# =============================================================================
# GLOBAL METRICS ENDPOINT
# =============================================================================
:2019 {
    metrics /metrics
}

# =============================================================================
# WEBSITE
# =============================================================================
semantec.lan, www.semantec.lan, web.semantec.lan, dev.semantec.lan, lab.semantec.lan, portal.semantec.lan, devlab.semantec.lan {
    # VictoriaMetrics API & CORS
    handle /vm/* {
        uri strip_prefix /vm
        reverse_proxy victoriametrics:8428
        header Access-Control-Allow-Origin {header.Origin}
        header Access-Control-Allow-Methods "GET, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type"
    }

    # Alertmanager API & CORS
    handle /am/* {
        uri strip_prefix /am
        reverse_proxy alertmanager:9093
        header Access-Control-Allow-Origin {header.Origin}
        header Access-Control-Allow-Methods "GET, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type"
    }

    # Frontend
    reverse_proxy website:80
    log {
        output stdout
        format json
    }
}

