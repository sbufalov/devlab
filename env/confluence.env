# --- REVERSE PROXY & HTTPS CONFIGURATION ---
# Tells Confluence it is running behind Caddy on port 443 with HTTPS
ATL_PROXY_NAME=confluence.semantec.lan
ATL_PROXY_PORT=443
ATL_TOMCAT_SCHEME=https
ATL_TOMCAT_SECURE=true

# --- AGGRESSIVE MEMORY COMPRESSION (JVM Heap) ---
# Hard-restrict Java memory layout to fit within small homelab boundaries.
# Reduces initial RAM allocation from 2GB down to 1GB.
JVM_MINIMUM_MEMORY=1024m
JVM_MAXIMUM_MEMORY=1536m

# --- PERFORMANCE TUNING ---
# Disable heavy corporate data collection and tracking back to Atlassian
ATL_ANALYTICS_DATA_COLLECTION=false
