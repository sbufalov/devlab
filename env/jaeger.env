# Collector Configuration
COLLECTOR_OTLP_ENABLED=true
COLLECTOR_ZIPKIN_HOST_PORT=:9411

# Storage Backend - Badger (Embedded Key-Value Store)
SPAN_STORAGE_TYPE=badger
BADGER_EPHEMERAL=false
BADGER_DIRECTORY_VALUE=/badger/data
BADGER_DIRECTORY_KEY=/badger/key
BADGER_SPAN_STORE_TTL=168h
BADGER_VALUE_LOG_FILE_SIZE=134217728
BADGER_CONSISTENCY=false
BADGER_MAINTENANCE_INTERVAL=5m
BADGER_METRICS_UPDATE_INTERVAL=10s

# Query Service
QUERY_BASE_PATH=/
QUERY_LOG_LEVEL=info
QUERY_MAX_CLOCK_SKEW_ADJUSTMENT=0s

# UI Configuration
JAEGER_DISABLED=false

# Sampling Configuration
SAMPLING_STRATEGIES_FILE=/etc/jaeger/sampling.json

# Metrics
METRICS_BACKEND=prometheus
METRICS_HTTP_ROUTE=/metrics
