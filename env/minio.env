# Root credentials
MINIO_ROOT_USER=semantec
MINIO_ROOT_PASSWORD=grossberg

# Server configuration
MINIO_BROWSER=on
MINIO_DOMAIN=minio.semantec.lan
MINIO_SERVER_URL=https://minio.semantec.lan

# Region (for S3 compatibility)
MINIO_REGION_NAME=us-east-1
MINIO_SITE_REGION=us-east-1

# Console configuration
MINIO_BROWSER_REDIRECT_URL=https://minio.semantec.lan

# Prometheus metrics
MINIO_PROMETHEUS_AUTH_TYPE=public
MINIO_PROMETHEUS_URL=http://otel:8888
MINIO_PROMETHEUS_JOB_ID=minio

# Storage class (for erasure coding, not needed for single-node)
# MINIO_STORAGE_CLASS_STANDARD=EC:2

# Compression (reduce disk usage)
MINIO_COMPRESS=on
MINIO_COMPRESS_EXTENSIONS=.txt,.log,.csv,.json,.tar,.xml,.bin,.parquet
MINIO_COMPRESS_MIME_TYPES=text/*,application/json,application/xml

# API configuration
MINIO_API_REQUESTS_MAX=10000
MINIO_API_REQUESTS_DEADLINE=10s

# Performance tuning for SSD
MINIO_API_SYNC_EVENTS=off
MINIO_CACHE_DRIVES=off
MINIO_CACHE_EXCLUDE=
MINIO_CACHE_EXPIRY=90
MINIO_CACHE_QUOTA=80

# Console logging
MINIO_LOG_LEVEL=INFO
