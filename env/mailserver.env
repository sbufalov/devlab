OVERRIDE_HOSTNAME=mail.semantec.lan
DOMAINNAME=semantec.lan
CONTAINER_NAME=mailserver
LOG_LEVEL=info
TZ=UTC
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_FAIL2BAN=1
SSL_TYPE=manual
SSL_CERT_PATH=/caddy-certs/caddy/certificates/local/mail.semantec.lan/mail.semantec.lan.crt
SSL_KEY_PATH=/caddy-certs/caddy/certificates/local/mail.semantec.lan/mail.semantec.lan.key
ONE_DIR=1
PERMIT_DOCKER=network
