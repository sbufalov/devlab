# Default database and user
CLICKHOUSE_DB=semantec
CLICKHOUSE_USER=semantec
CLICKHOUSE_PASSWORD=grossberg

# Default access management
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1

# Log level
CLICKHOUSE_LOG_LEVEL=information

# Max memory usage (80% of container limit)
CLICKHOUSE_MAX_MEMORY_USAGE=1600000000

# Performance settings
CLICKHOUSE_MAX_CONCURRENT_QUERIES=100
CLICKHOUSE_MAX_CONNECTIONS=1000
