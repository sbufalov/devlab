{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HomelabBucketLevelActions",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::mlflow",
        "arn:aws:s3:::pyroscope",
        "arn:aws:s3:::backups",
        "arn:aws:s3:::outline",
        "arn:aws:s3:::plane",
        "arn:aws:s3:::dify",
        "arn:aws:s3:::onyx"
      ]
    },
    {
      "Sid": "HomelabObjectLevelActions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::mlflow/*",
        "arn:aws:s3:::pyroscope/*",
        "arn:aws:s3:::backups/*",
        "arn:aws:s3:::outline/*",
        "arn:aws:s3:::plane/*",
        "arn:aws:s3:::dify/*",
        "arn:aws:s3:::onyx/*"
      ]
    }
  ]
}
